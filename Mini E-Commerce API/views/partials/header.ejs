<!DOCTYPE html>
<html>
<head>
  <title><%= typeof title !== 'undefined' ? title : 'E-Commerce' %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }
    nav a {
      margin-right: 15px;
      text-decoration: none;
      color: #0066cc;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }
    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
    tr.stock-low {
      background-color: #ffe6e6;
      font-weight: bold;
    }
    .stock-low-text {
      color: #cc0000;
      font-weight: bold;
    }
  </style>
</head>
<body>
<nav>
  <a href="/view/products">Products</a>
  <a href="/view/products/new">Add Product</a>
  <a href="/view/login">Login</a>
</nav>
<hr>